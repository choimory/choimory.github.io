---
layout: compress
---

{% assign favicon_path = '/assets/img/favicons' | relative_url %}
{% assign favicon_version = '20261118-2' %}
{% assign start_url = '/index.html' | relative_url %}

{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    {
      "src": "{{ favicon_path }}/web-app-manifest-192x192.png?v={{ favicon_version }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ favicon_path }}/web-app-manifest-512x512.png?v={{ favicon_version }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": {{ start_url | jsonify }},
  "theme_color": "#ffdf73",
  "background_color": "#ffdf73",
  "display": "standalone"
}
